// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js Prisma adapter shape) ----------

enum Role {
  ADMIN
  SELF_ASSESSOR
  MANAGER_REVIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(SELF_ASSESSOR)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  assessmentsAsSubject  Assessment[] @relation("AssessmentSubject")
  assessmentsAsAssessor Assessment[] @relation("AssessmentAssessor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Competency framework ----------

model Framework {
  id             String         @id @default(cuid())
  name           String
  description    String?
  scaleId        String
  rollupStrategy RollupStrategy @default(WEIGHTED_AVERAGE)
  createdAt      DateTime       @default(now())

  scale       Scale        @relation(fields: [scaleId], references: [id])
  levels      Level[]
  categories  Category[]
  assessments Assessment[]
}

enum RollupStrategy {
  WEIGHTED_AVERAGE
  MEDIAN_PENALIZED
}

model Scale {
  id          String @id @default(cuid())
  name        String
  description String?

  points     ScalePoint[]
  frameworks Framework[]
}

model ScalePoint {
  id        String @id @default(cuid())
  scaleId   String
  score     Float
  label     String
  percent   Float
  sortOrder Int    @default(0)

  scale Scale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, score])
}

model Level {
  id          String @id @default(cuid())
  frameworkId String
  name        String
  shortName   String
  description String
  sortOrder   Int    @default(0)

  framework           Framework            @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  competencies         Competency[]
  categoryLevelTargets CategoryLevelTarget[]
  assessments          Assessment[]
}

model Category {
  id          String @id @default(cuid())
  frameworkId String
  name        String
  sortOrder   Int    @default(0)

  framework    Framework             @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  competencies Competency[]
  targets      CategoryLevelTarget[]
}

model CategoryLevelTarget {
  id            String @id @default(cuid())
  categoryId    String
  levelId       String
  targetPercent Float

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level    Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([categoryId, levelId])
}

model Competency {
  id                      String  @id @default(cuid())
  categoryId              String
  levelId                 String
  name                    String
  isConditional           Boolean @default(false)
  conditionalQuestionText String?
  weight                  Float   @default(1.0)
  sortOrder               Int     @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level    Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  actions  Action[]

  assessmentAnswers AssessmentAnswer[]

  @@unique([categoryId, levelId, name])
}

model Action {
  id           String @id @default(cuid())
  competencyId String
  statement    String
  weight       Float  @default(1.0)
  sortOrder    Int    @default(0)

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  scores AssessmentScore[]
}

// ---------- Assessments ----------

enum AssessmentStatus {
  DRAFT
  SUBMITTED
}

enum AssessorRole {
  SELF
  MANAGER
}

model Assessment {
  id            String            @id @default(cuid())
  frameworkId   String
  levelId       String
  subjectUserId String
  assessorUserId String
  assessorRole  AssessorRole      @default(SELF)
  status        AssessmentStatus  @default(DRAFT)
  createdAt     DateTime          @default(now())
  submittedAt   DateTime?

  framework Framework @relation(fields: [frameworkId], references: [id])
  level     Level     @relation(fields: [levelId], references: [id])
  subject   User      @relation("AssessmentSubject", fields: [subjectUserId], references: [id])
  assessor  User      @relation("AssessmentAssessor", fields: [assessorUserId], references: [id])

  scores          AssessmentScore[]
  answers         AssessmentAnswer[]
  developmentPlan DevelopmentPlan?
}

model AssessmentAnswer {
  id           String  @id @default(cuid())
  assessmentId String
  competencyId String
  answer       Boolean

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, competencyId])
}

model AssessmentScore {
  id           String   @id @default(cuid())
  assessmentId String
  actionId     String
  score        Float
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  action     Action     @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, actionId])
}

model DevelopmentPlan {
  id            String   @id @default(cuid())
  assessmentId  String   @unique
  content       String // JSON-encoded structured plan
  modelUsed     String
  generatedAt   DateTime @default(now())
  rawPromptMeta String? // JSON-encoded, optional

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}
