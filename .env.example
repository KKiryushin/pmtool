DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Required only for the LLM development-plan feature. Leave unset to run
# without it — the rest of the app works fine.
OPENAI_API_KEY=""

# Used by prisma/seed.ts to create the initial admin account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
# If unset, the seed script generates a random password and prints it once.
SEED_ADMIN_PASSWORD=""
